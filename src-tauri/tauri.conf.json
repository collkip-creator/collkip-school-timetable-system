{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Collkip School Timetable System",
  "version": "0.1.0",
  "identifier": "com.collkip.schooltimetable",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Collkip School Timetable System",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Education",
    "shortDescription": "Offline-first school timetable management",
    "longDescription": "Create, validate, manage and print school timetables locally."
  }
}